# Copy to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=3847
# Public origin used in email links. Required in production.
PUBLIC_APP_URL=http://localhost:3847
# Set to 1 when the app is behind a reverse proxy.
TRUST_PROXY=

# manual | stripe | none
# development defaults to manual. production defaults to none until a key is set.
BILLING_PROVIDER=manual
BILLING_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional self-serve Team price in cents. Leave empty to keep Team as contact sales.
BILLING_TEAM_MONTHLY_CENTS=
BILLING_TEAM_YEARLY_MONTHLY_CENTS=

# Email. Without a webhook, messages are stored in data/outbox.json.
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_SECRET=
EMAIL_OUTBOX=1
SUPPORT_EMAIL=hello@reelcreator.app

# Optional analytics. Empty values load nothing.
GA_MEASUREMENT_ID=
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com
PLAUSIBLE_DOMAIN=
MIXPANEL_TOKEN=
CLARITY_PROJECT_ID=

# Optional monitoring. Browser DSNs are public by design.
SENTRY_DSN=
LOGROCKET_APP_ID=
MONITOR_WEBHOOK_URL=

# Renderer
FFMPEG_PATH=
CHROME_PATH=
