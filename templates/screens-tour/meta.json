{
  "name": "Screenshot Tour",
  "description": "Your real app screenshots in a phone, one per caption → download end card",
  "duration": 14.8,
  "thumbnail": "preview.svg",
  "fields": [
    { "type": "group", "label": "Brand" },
    { "key": "appName", "label": "App name", "type": "text" },
    { "key": "tagline", "label": "Tagline", "type": "text" },
    { "key": "logoUrl", "label": "Logo", "type": "image" },
    { "type": "group", "label": "Screens" },
    { "key": "screenCount", "label": "Number of screens", "type": "select", "options": ["1", "2", "3", "4"] },
    { "key": "secondsPerScreen", "label": "Seconds per screen", "type": "range", "min": 1.2, "max": 5, "step": 0.1, "unit": "s" },
    { "key": "transition", "label": "Screen transition", "type": "select", "options": [{ "value": "slide", "label": "Slide" }, { "value": "zoom", "label": "Zoom" }, { "value": "fade", "label": "Fade" }] },
    { "key": "device", "label": "Device frame", "type": "select", "options": [{ "value": "dark", "label": "Graphite phone" }, { "value": "light", "label": "Silver phone" }, { "value": "flat", "label": "No frame" }] },
    { "key": "showStepLabels", "label": "Show 01 / 04 labels", "type": "boolean" },
    { "key": "image1", "label": "Screenshot 1", "type": "image", "hint": "Portrait screenshot, ~1170×2532" },
    { "key": "caption1", "label": "Caption 1", "type": "text" },
    { "key": "image2", "label": "Screenshot 2", "type": "image" },
    { "key": "caption2", "label": "Caption 2", "type": "text" },
    { "key": "image3", "label": "Screenshot 3", "type": "image" },
    { "key": "caption3", "label": "Caption 3", "type": "text" },
    { "key": "image4", "label": "Screenshot 4", "type": "image" },
    { "key": "caption4", "label": "Caption 4", "type": "text" },
    { "type": "group", "label": "End card" },
    { "key": "ctaText", "label": "Button text", "type": "text" },
    { "key": "showStores", "label": "Show store badges", "type": "boolean" },
    { "key": "footer", "label": "Footer / handle", "type": "text" },
    { "type": "group", "label": "Style" },
    { "key": "font", "label": "Font", "type": "font" },
    { "key": "theme", "label": "Theme", "type": "select", "options": [{ "value": "light", "label": "Light" }, { "value": "dark", "label": "Dark" }] },
    { "key": "primary", "label": "Accent color", "type": "color" },
    { "key": "secondary", "label": "Second color", "type": "color" },
    { "key": "background", "label": "Background", "type": "color" },
    { "key": "bgStyle", "label": "Background style", "type": "bgStyle" }
  ],
  "defaults": {
    "appName": "Your App",
    "tagline": "Say what your app does in one line",
    "logoUrl": "",
    "screenCount": "4",
    "secondsPerScreen": 2.4,
    "transition": "slide",
    "device": "dark",
    "showStepLabels": true,
    "image1": "", "caption1": "Your main screen",
    "image2": "", "caption2": "Your best feature",
    "image3": "", "caption3": "Another great feature",
    "image4": "", "caption4": "See your progress",
    "ctaText": "Download free",
    "showStores": true,
    "footer": "@yourapp",
    "font": "Manrope",
    "theme": "light",
    "primary": "#34C759",
    "secondary": "#0A84FF",
    "background": "#F4FAF6",
    "bgStyle": "gradient"
  }
}
