{
  "name": "App Reviews",
  "description": "Star rating counts up → user review cards → social-proof download card",
  "duration": 12.0,
  "thumbnail": "preview.svg",
  "fields": [
    { "type": "group", "label": "Rating" },
    { "key": "headline", "label": "Headline", "type": "text" },
    { "key": "rating", "label": "Star rating", "type": "range", "min": 1, "max": 5, "step": 0.1, "unit": "★" },
    { "key": "ratingLabel", "label": "Rating label", "type": "text" },
    { "key": "starColor", "label": "Star color", "type": "color" },
    { "type": "group", "label": "Reviews" },
    { "key": "reviewCount", "label": "Number of reviews", "type": "select", "options": ["1", "2", "3"] },
    { "key": "layout", "label": "Card layout", "type": "select", "options": [{ "value": "list", "label": "List (slide in)" }, { "value": "stack", "label": "Stack (pile up)" }, { "value": "single", "label": "One at a time" }] },
    { "key": "reviewSeconds", "label": "Seconds per review", "type": "range", "min": 0.8, "max": 4, "step": 0.1, "unit": "s" },
    { "key": "review1", "label": "Review 1", "type": "textarea", "rows": 3 },
    { "key": "name1", "label": "Reviewer 1", "type": "text" },
    { "key": "source1", "label": "Source 1", "type": "text" },
    { "key": "review2", "label": "Review 2", "type": "textarea", "rows": 3 },
    { "key": "name2", "label": "Reviewer 2", "type": "text" },
    { "key": "source2", "label": "Source 2", "type": "text" },
    { "key": "review3", "label": "Review 3", "type": "textarea", "rows": 3 },
    { "key": "name3", "label": "Reviewer 3", "type": "text" },
    { "key": "source3", "label": "Source 3", "type": "text" },
    { "type": "group", "label": "End card" },
    { "key": "appName", "label": "App name", "type": "text" },
    { "key": "logoUrl", "label": "Logo", "type": "image" },
    { "key": "ctaText", "label": "Button text", "type": "text" },
    { "key": "showStores", "label": "Show store badges", "type": "boolean" },
    { "key": "footer", "label": "Footer / handle", "type": "text" },
    { "type": "group", "label": "Style" },
    { "key": "font", "label": "Font", "type": "font" },
    { "key": "theme", "label": "Theme", "type": "select", "options": [{ "value": "light", "label": "Light" }, { "value": "dark", "label": "Dark" }] },
    { "key": "primary", "label": "Accent color", "type": "color" },
    { "key": "secondary", "label": "Second color", "type": "color" },
    { "key": "background", "label": "Background", "type": "color" },
    { "key": "bgStyle", "label": "Background style", "type": "bgStyle" }
  ],
  "defaults": {
    "headline": "Loved by 50,000+ people",
    "rating": 4.9,
    "ratingLabel": "Average from 12,000+ ratings",
    "starColor": "#FFB800",
    "reviewCount": "3",
    "layout": "list",
    "reviewSeconds": 1.8,
    "review1": "Exactly what I was looking for. Setup took two minutes and it just works.",
    "name1": "Priya S.", "source1": "App Store",
    "review2": "I use it every single day, and every update makes it better.",
    "name2": "Marcus T.", "source2": "Google Play",
    "review3": "Clean, fast and easy to use. It replaced three other apps for me.",
    "name3": "Elena R.", "source3": "App Store",
    "appName": "Your App",
    "logoUrl": "",
    "ctaText": "Join them — it's free",
    "showStores": true,
    "footer": "@yourapp",
    "font": "Manrope",
    "theme": "light",
    "primary": "#34C759",
    "secondary": "#0A84FF",
    "background": "#F4FAF6",
    "bgStyle": "glow"
  }
}
