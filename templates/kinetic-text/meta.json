{
  "name": "Kinetic Type",
  "description": "Bold words punch in line by line over color wipes → logo + CTA end card",
  "duration": 9.9,
  "thumbnail": "preview.svg",
  "fields": [
    { "type": "group", "label": "Text" },
    { "key": "lines", "label": "Lines (one per line)", "type": "textarea", "rows": 6 },
    { "key": "secondsPerLine", "label": "Seconds per line", "type": "range", "min": 0.5, "max": 3, "step": 0.1, "unit": "s" },
    { "key": "animation", "label": "Word animation", "type": "select", "options": [{ "value": "pop", "label": "Pop" }, { "value": "slide", "label": "Slide up (masked)" }, { "value": "fade", "label": "Fade up" }, { "value": "type", "label": "Typewriter" }] },
    { "key": "wipe", "label": "Panel transition", "type": "select", "options": [{ "value": "up", "label": "Wipe up" }, { "value": "left", "label": "Wipe left" }, { "value": "circle", "label": "Circle reveal" }, { "value": "cut", "label": "Hard cut" }] },
    { "key": "align", "label": "Alignment", "type": "select", "options": [{ "value": "center", "label": "Center" }, { "value": "left", "label": "Left" }] },
    { "key": "uppercase", "label": "Uppercase", "type": "boolean" },
    { "key": "textScale", "label": "Text size", "type": "range", "min": 0.5, "max": 1.3, "step": 0.05, "unit": "×" },
    { "key": "emphasis", "label": "Last word highlight", "type": "select", "options": [{ "value": "box", "label": "Marker box" }, { "value": "underline", "label": "Underline" }, { "value": "none", "label": "None" }] },
    { "key": "showBrandTag", "label": "App name at top", "type": "boolean" },
    { "key": "showProgress", "label": "Progress bar", "type": "boolean" },
    { "type": "group", "label": "Colors" },
    { "key": "color1", "label": "Panel color 1", "type": "color" },
    { "key": "color2", "label": "Panel color 2", "type": "color" },
    { "key": "color3", "label": "Panel color 3", "type": "color" },
    { "key": "primary", "label": "Highlight & button", "type": "color" },
    { "key": "endBackground", "label": "End card background", "type": "color" },
    { "key": "font", "label": "Font", "type": "font" },
    { "type": "group", "label": "End card" },
    { "key": "appName", "label": "App name", "type": "text" },
    { "key": "logoUrl", "label": "Logo", "type": "image" },
    { "key": "endTitle", "label": "Title", "type": "text" },
    { "key": "endSubtitle", "label": "Subtitle", "type": "text" },
    { "key": "ctaText", "label": "Button text", "type": "text" },
    { "key": "showStores", "label": "Show store badges", "type": "boolean" }
  ],
  "defaults": {
    "lines": "Your hook\ngoes here.\nOne idea\nper line.\nKeep it short.",
    "secondsPerLine": 1.3,
    "animation": "pop",
    "wipe": "up",
    "align": "center",
    "uppercase": true,
    "textScale": 1,
    "emphasis": "box",
    "showBrandTag": true,
    "showProgress": true,
    "color1": "#111216",
    "color2": "#34C759",
    "color3": "#F4F1E8",
    "primary": "#FFD60A",
    "endBackground": "#111216",
    "font": "Anton",
    "appName": "Your App",
    "logoUrl": "",
    "endTitle": "Your App",
    "endSubtitle": "Your one-line tagline here",
    "ctaText": "Download free",
    "showStores": true
  }
}
