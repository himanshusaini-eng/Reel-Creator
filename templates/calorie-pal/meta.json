  "defaults": {
    "appName": "Your App",
    "tagline": "Your one-line tagline here",
    "primary": "#34C759",
    "primaryDark": "#248A3D",
    "goal": 2100,
    "food": 1450,
    "burned": 280,
    "lunchMeal": "Dal Tadka + Rice",
    "showStores": true,
    "footer": "Download free on iOS & Android"
