    "pillSmall": "protein", "pillBig": "calories",
    "whip": "smart", "aiBig": "AI", "aiSmall": "meal plans", "everyWeek": "every week",
    "logCap": "log any meal", "typeFull": "oats & berries", "logged": "logged",
    "secTop": "log it in", "secBig": "SECONDS",
    "move": "MOVE", "movePill": "every step earns coins", "steps": "8,432 steps", "coins": 84,
    "endTitle": "Your App", "endSub": "Your one-line tagline here", "endFoot": "free on iOS & Android",
    "rating": 0,
    "sound": true, "musicVolume": 0.9, "sfxVolume": 1.2, "bpm": 124
  }
}
