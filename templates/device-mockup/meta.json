{
  "name": "Device Mockup",
  "description": "Your screen recording or screenshot inside an iPhone, Android, iPad or MacBook frame",
  "duration": 10,
  "order": 0,
  "thumbnail": "preview.svg",
  "fields": [
    { "type": "group", "label": "Screen" },
    { "key": "media", "label": "Screen recording or screenshot", "type": "media", "hint": "MP4, WebM or MOV recording, or a PNG/JPG. A recording shorter than the reel loops." },
    { "key": "mediaFit", "label": "Fit", "type": "select", "options": [{ "value": "cover", "label": "Fill the screen" }, { "value": "contain", "label": "Show everything" }] },
    { "key": "videoOffset", "label": "Start recording at", "type": "range", "min": 0, "max": 30, "step": 0.1, "unit": "s" },
    { "key": "length", "label": "Reel length", "type": "range", "min": 3, "max": 60, "step": 0.5, "unit": "s" },
    { "type": "group", "label": "Device" },
    { "key": "device", "label": "Device", "type": "select", "options": [{ "value": "iphone", "label": "iPhone" }, { "value": "android", "label": "Android phone" }, { "value": "ipad", "label": "iPad" }, { "value": "macbook", "label": "MacBook" }, { "value": "none", "label": "No frame" }] },
    { "key": "finish", "label": "Finish", "type": "select", "options": [{ "value": "graphite", "label": "Graphite" }, { "value": "silver", "label": "Silver" }, { "value": "accent", "label": "Accent color" }] },
    { "key": "motion", "label": "Motion", "type": "select", "options": [{ "value": "float", "label": "Gentle float" }, { "value": "tilt", "label": "3D tilt" }, { "value": "zoom", "label": "Slow zoom" }, { "value": "orbit", "label": "Orbit" }, { "value": "static", "label": "Still" }] },
    { "key": "deviceSize", "label": "Device size", "type": "range", "min": 60, "max": 110, "step": 1, "unit": "%" },
    { "type": "group", "label": "Text" },
    { "key": "showText", "label": "Show headline", "type": "boolean" },
    { "key": "textPosition", "label": "Text position", "type": "select", "options": [{ "value": "top", "label": "Above device" }, { "value": "bottom", "label": "Below device" }] },
    { "key": "eyebrow", "label": "Small label", "type": "text" },
    { "key": "headline", "label": "Headline", "type": "text" },
    { "key": "subhead", "label": "Subheadline", "type": "text" },
    { "type": "group", "label": "Style" },
    { "key": "font", "label": "Font", "type": "font" },
    { "key": "theme", "label": "Theme", "type": "select", "options": [{ "value": "light", "label": "Light" }, { "value": "dark", "label": "Dark" }] },
    { "key": "primary", "label": "Accent color", "type": "color" },
    { "key": "secondary", "label": "Second color", "type": "color" },
    { "key": "background", "label": "Background", "type": "color" },
    { "key": "bgStyle", "label": "Background style", "type": "bgStyle" }
  ],
  "defaults": {
    "media": "",
    "mediaFit": "cover",
    "videoOffset": 0,
    "length": 10,
    "device": "iphone",
    "finish": "graphite",
    "motion": "float",
    "deviceSize": 100,
    "showText": true,
    "textPosition": "top",
    "eyebrow": "NEW",
    "headline": "See it in action",
    "subhead": "Say what your app does in one line",
    "font": "Manrope",
    "theme": "dark",
    "primary": "#34C759",
    "secondary": "#0A84FF",
    "background": "#0E0F13",
    "bgStyle": "glow"
  }
}
