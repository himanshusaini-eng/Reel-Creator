{
  "name": "Stats Count-up",
  "description": "Big numbers count up with rings or bars — results, users, ratings → CTA",
  "duration": 9.4,
  "thumbnail": "preview.svg",
  "fields": [
    { "type": "group", "label": "Headline" },
    { "key": "eyebrow", "label": "Small label", "type": "text" },
    { "key": "headline", "label": "Headline", "type": "text" },
    { "type": "group", "label": "Stats" },
    { "key": "statCount", "label": "Number of stats", "type": "select", "options": ["1", "2", "3", "4"] },
    { "key": "visual", "label": "Visual", "type": "select", "options": [{ "value": "ring", "label": "Progress ring" }, { "value": "bar", "label": "Progress bar" }, { "value": "plain", "label": "Number only" }] },
    { "key": "statSeconds", "label": "Seconds per stat", "type": "range", "min": 0.6, "max": 3, "step": 0.1, "unit": "s" },
    { "key": "value1", "label": "Stat 1 value", "type": "text", "hint": "Number counts up; text around it stays, e.g. 2.4M+ or $1,200" },
    { "key": "label1", "label": "Stat 1 label", "type": "text" },
    { "key": "fill1", "label": "Stat 1 ring/bar fill", "type": "range", "min": 0, "max": 100, "step": 1, "unit": "%" },
    { "key": "value2", "label": "Stat 2 value", "type": "text" },
    { "key": "label2", "label": "Stat 2 label", "type": "text" },
    { "key": "fill2", "label": "Stat 2 ring/bar fill", "type": "range", "min": 0, "max": 100, "step": 1, "unit": "%" },
    { "key": "value3", "label": "Stat 3 value", "type": "text" },
    { "key": "label3", "label": "Stat 3 label", "type": "text" },
    { "key": "fill3", "label": "Stat 3 ring/bar fill", "type": "range", "min": 0, "max": 100, "step": 1, "unit": "%" },
    { "key": "value4", "label": "Stat 4 value", "type": "text" },
    { "key": "label4", "label": "Stat 4 label", "type": "text" },
    { "key": "fill4", "label": "Stat 4 ring/bar fill", "type": "range", "min": 0, "max": 100, "step": 1, "unit": "%" },
    { "type": "group", "label": "End card" },
    { "key": "appName", "label": "App name", "type": "text" },
    { "key": "tagline", "label": "Tagline", "type": "text" },
    { "key": "logoUrl", "label": "Logo", "type": "image" },
    { "key": "ctaText", "label": "Button text", "type": "text" },
    { "key": "showStores", "label": "Show store badges", "type": "boolean" },
    { "key": "footer", "label": "Footer / handle", "type": "text" },
    { "type": "group", "label": "Style" },
    { "key": "font", "label": "Font", "type": "font" },
    { "key": "theme", "label": "Theme", "type": "select", "options": [{ "value": "light", "label": "Light" }, { "value": "dark", "label": "Dark" }] },
    { "key": "primary", "label": "Accent color", "type": "color" },
    { "key": "secondary", "label": "Second color", "type": "color" },
    { "key": "background", "label": "Background", "type": "color" },
    { "key": "bgStyle", "label": "Background style", "type": "bgStyle" }
  ],
  "defaults": {
    "eyebrow": "THE RESULTS",
    "headline": "Your results, in numbers",
    "statCount": "3",
    "visual": "ring",
    "statSeconds": 1.3,
    "value1": "2.4M+", "label1": "downloads worldwide", "fill1": 82,
    "value2": "3x", "label2": "faster than doing it by hand", "fill2": 64,
    "value3": "4.9★", "label3": "rating on the App Store", "fill3": 98,
    "value4": "93%", "label4": "of users come back every day", "fill4": 93,
    "appName": "Your App",
    "tagline": "Start your streak today",
    "logoUrl": "",
    "ctaText": "Download free",
    "showStores": true,
    "footer": "@yourapp",
    "font": "Sora",
    "theme": "dark",
    "primary": "#34C759",
    "secondary": "#30D5C8",
    "background": "#0B0D12",
    "bgStyle": "grid"
  }
}
